# BMG School frontend — API manzili
# Lokal development uchun backend manzili (backend/.env dagi PORT bilan mos bo'lishi kerak)
VITE_API_URL=http://localhost:5000/api

# Production'ga deploy qilganda (Vercel/Netlify), backend manzilingizni kiriting:
# VITE_API_URL=https://sizning-backend-domeningiz.com/api

# Admin panelga kirish manzili. Standart qiymat /bmg-panel-kirish, lekin
# xavfsizlik uchun buni o'zingizga xos, taxmin qilib bo'lmaydigan qiymatga
# o'zgartiring. Bu yo'lni hech qayerda ochiq ko'rsatmang (sitemap, footer va h.k.)
VITE_ADMIN_LOGIN_PATH=/bmg-panel-kirish
